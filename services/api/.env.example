# EAS API environment (PRD 7.4 - zod env schema in src/env.ts fails fast at boot)
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL (Neon / Render / AWS RDS)
DATABASE_URL=postgresql://user:password@localhost:5432/eas

# JWT secrets - at least 16 chars each (generate: openssl rand -hex 32)
JWT_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-at-least-16-chars
JWT_ACCESS_TTL_SEC=900      # 15 min (PRD 4.1)
JWT_REFRESH_TTL_SEC=604800  # 7 days (PRD 4.1)

# Termii SMS (https://termii.com) - leave empty to run in dev mode
# where OTP codes are logged to console instead of sent.
TERMII_API_KEY=
TERMII_SENDER_ID=EAS

# Android SMS Retriever app hash (optional) - appended to the OTP SMS body
# ("\n<#> hash") so Play Services can auto-read the code. Generate with
# Google's AppHash tool for your signing keystore.
SMS_RETRIEVER_HASH=

# Paystack (https://paystack.com) - Transfers API for wallet cashouts (PRD 5.4).
# Leave PAYSTACK_SECRET_KEY empty for local dev: the API runs a built-in MOCK
# service instead (transfers settle instantly, account 0000000000 simulates a
# failure so the auto-refund path is testable, no network calls made).
# Set a sk_test_... key to call the real Paystack sandbox.
PAYSTACK_SECRET_KEY=
# Force mock mode even when a secret key is configured (true/false)
PAYSTACK_MOCK=false

# Dev convenience: log OTP codes to console (overridden in production)
OTP_DEBUG_LOG=true

# Android SMS Retriever app hash (11 chars) so the mobile app can auto-read
# the OTP SMS. Generate it for your signing keystore with Google's AppHash
# tool (https://developers.google.com/identity/sms-retriever/verify).
# Leave empty in dev — autofill stays off and manual entry still works.
SMS_RETRIEVER_HASH=